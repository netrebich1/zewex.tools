DATABASE_URL="mysql://zewex_app:PASSWORD@localhost:3306/zewex_tools"
# 32 bytes in hex (64 hex chars): openssl rand -hex 32
APP_ENCRYPTION_KEY=""
# emails allowed to self-register (comma separated)
ALLOWED_REGISTRATION_EMAILS="netrebich.y.a@gmail.com"
APP_URL="https://zewex.tools"
# optional: set to ".zewex.tools" once tools run on subdomains and must share the session cookie
SESSION_COOKIE_DOMAIN=""
# optional: extra browser origins allowed to call /api/run (comma separated), e.g. https://pins.zewex.tools
API_ALLOWED_ORIGINS=""
# Трафик сайтов (Google Analytics): OAuth-клиент из Google Cloud Console (тип «Web application»),
# redirect URI = <APP_URL>/api/analytics/oauth/callback. Без них кнопка «Подключить Google-аккаунт» скрыта.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# optional: часовой пояс «сегодня» для сводок по всем сайтам (по умолчанию Europe/Kyiv) и параллельность синхронизации
GA_DEFAULT_TZ=Europe/Kyiv
GA_SYNC_CONCURRENCY=2
GA_SYNC_INTERVAL_MIN=60
