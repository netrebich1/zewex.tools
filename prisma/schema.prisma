generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum ProviderKind {
  LLM
  DATA
}

enum AuthType {
  BEARER
  BASIC
  QUERY
}

enum Adapter {
  OPENAI_COMPAT
  DATAFORSEO
  SERPAPI
}

enum Capability {
  CHAT
  IMAGE
  EMBEDDING
  SERP
  SEO_DATA
}

enum KeyStatus {
  ACTIVE
  DISABLED
}

enum ModelSource {
  SYNCED
  MANUAL
}

enum BindingScope {
  USER_PROJECT
  TEAM_PROJECT
  PROJECT
  TEAM
  GLOBAL
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String?
  role          Role         @default(MEMBER)
  isActive      Boolean      @default(true)
  inviteToken   String?      @unique
  inviteExpires DateTime?
  /// Права участника (JSON `Permissions` из src/lib/permissions.ts); null — права по умолчанию. Для ADMIN не учитываются.
  permissions   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  memberships   TeamMember[]
  apiKeys       ApiKey[]
  bindings      Binding[]
  usage         UsageLog[]
  siteViews     SiteAccessViewer[]
  favorites     FavoriteTool[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  members     TeamMember[]
  bindings    Binding[]
  pinSites    PinSite[]
  artSites    ArtSite[]
  artRuns     ArtRun[]
  articles    Article[]
  pinRuns     PinRun[]
  siteShares  SiteAccessTeam[]
  apiKeys     ApiKey[]
}

model TeamMember {
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Section {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String    @default("grid")
  order     Int       @default(0)
  projects  Project[]
}

model Project {
  id          String     @id @default(cuid())
  sectionId   String
  name        String
  slug        String     @unique
  description String?
  url         String?
  status      String     @default("PLANNED")
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  section     Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slots       Slot[]
  usage       UsageLog[]
  favorites   FavoriteTool[]
}

/// Избранные инструменты пользователя (звёздочка на главной)
model FavoriteTool {
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Slot {
  id          String     @id @default(cuid())
  projectId   String
  key         String
  name        String
  capability  Capability
  description String?
  /// Предпочтительные провайдеры через запятую (slug), если у слота несколько ключей разных провайдеров
  preferProviders String?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bindings    Binding[]
  usage       UsageLog[]

  @@unique([projectId, key])
}

model Provider {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  kind           ProviderKind
  adapter        Adapter
  authType       AuthType
  baseUrl        String
  modelsEndpoint String?
  docsUrl        String?
  isActive       Boolean      @default(true)
  order          Int          @default(0)
  /// Модель по умолчанию для текстовых слотов (modelId как в API провайдера)
  defaultChatModel  String?
  /// Модель по умолчанию для слотов картинок
  defaultImageModel String?
  /// Отдельный токен аккаунта для запроса баланса (laozhang: «System Token»), зашифрован
  balanceTokenEnc  String?  @db.Text
  balanceTokenHint String?
  models         Model[]
  apiKeys        ApiKey[]
  bindings       Binding[]
  usage          UsageLog[]
}

model Model {
  id            String      @id @default(cuid())
  providerId    String
  modelId       String
  name          String
  capabilities  String      @default("CHAT")
  inputPrice    Float?
  outputPrice   Float?
  unitPrice     Float?
  contextLength Int?
  isEnabled     Boolean     @default(false)
  source        ModelSource @default(MANUAL)
  createdAt     DateTime    @default(now())
  provider      Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bindings      Binding[]
  usage         UsageLog[]

  @@unique([providerId, modelId])
}

model ApiKey {
  id              String     @id @default(cuid())
  providerId      String
  label           String
  secretEnc       String     @db.Text
  secretHint      String
  ownerId         String?
  /// Командный ключ: виден участникам команды и назначается только её правилам. Пусто и без владельца — общий ключ.
  teamId          String?
  status          KeyStatus  @default(ACTIVE)
  monthlyLimitUsd Float?
  notes           String?
  lastCheckedAt   DateTime?
  lastCheckOk     Boolean?
  lastCheckNote   String?
  createdAt       DateTime   @default(now())
  provider        Provider   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  owner           User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  team            Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  bindings        Binding[]
  usage           UsageLog[]

  @@index([teamId])
}

model Binding {
  id         String       @id @default(cuid())
  scope      BindingScope
  slotId     String?
  userId     String?
  teamId     String?
  capability Capability?
  providerId String
  modelId    String?
  apiKeyId   String
  createdAt  DateTime     @default(now())
  slot       Slot?        @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  provider   Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model      Model?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  apiKey     ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)

  @@index([slotId])
  @@index([teamId])
  @@index([userId])
}

model UsageLog {
  id           String       @id @default(cuid())
  userId       String?
  projectId    String?
  slotId       String?
  providerId   String
  modelId      String?
  apiKeyId     String?
  scope        BindingScope?
  inputTokens  Int          @default(0)
  outputTokens Int          @default(0)
  units        Int          @default(1)
  costUsd      Float?
  durationMs   Int          @default(0)
  ok           Boolean      @default(true)
  error        String?      @db.Text
  teamId       String?
  refId        String?
  createdAt    DateTime     @default(now())
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  slot         Slot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  provider     Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  model        Model?       @relation(fields: [modelId], references: [id], onDelete: SetNull)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([apiKeyId, createdAt])
  @@index([userId, createdAt])
  @@index([refId])
  @@index([teamId, createdAt])
}

// ───────────────────────────── Pinterest Pins ─────────────────────────────
// Сервис массового создания пинов. Все модели с префиксом Pin. Данные команды
// изолированы по teamId (портальная Team). Тяжёлую работу выполняет только
// воркер (worker/), Next.js лишь ставит задачи и читает агрегаты.

enum PinRunStatus {
  DRAFT
  QUEUED
  RUNNING
  WAITING_MODERATION
  BLOCKED
  STOPPED
  DONE
  FAILED
}

enum PinJobStatus {
  PENDING
  RUNNING
  STOPPING
  DONE
  ERROR
  STOPPED
}

enum PinEngine {
  OPENAI
  PINORA
  CANVAS
  PHOTO
}

enum PinItemStatus {
  PENDING
  READY
  ERROR
  POOL
  REMOVED
}

enum PinModeration {
  NONE
  APPROVED
  REJECTED
}

model PinSite {
  id             String   @id @default(uuid()) @db.Char(36)
  teamId         String
  name           String
  slug           String
  niche          String   @default("")
  recipe         Json
  legacy         Json?
  wpConnectionId String?  @db.Char(36)
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  boards         PinBoard[]
  sets           PinSet[]
  runs           PinRun[]
  exclusions     PinStyleExclusion[]

  @@unique([teamId, slug])
  @@index([teamId])
}

model PinBoard {
  id        String  @id @default(uuid()) @db.Char(36)
  siteId    String  @db.Char(36)
  name      String
  sortOrder Int     @default(0)
  site      PinSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model PinSet {
  id        String   @id @default(uuid()) @db.Char(36)
  siteId    String   @db.Char(36)
  name      String
  topic     String   @default("")
  setKind   String   @default("ai")
  styleIds  Json
  pinCount  Int      @default(0)
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      PinSite  @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model PinCanvasStyle {
  id          String   @id @db.VarChar(160)
  libraryId   String   @default("other")
  name        String
  category    String   @default("")
  data        Json
  isActive    Boolean  @default(true)
  isApproved  Boolean  @default(false)
  sortOrder   Int      @default(0)
  previewPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([libraryId, isActive])
}

model PinPinoraTheme {
  id           String @id @default(uuid()) @db.Char(36)
  name         String @unique
  displayName  String
  instructions Json
  learnedRules Json
  sortOrder    Int    @default(0)
}

model PinExample {
  id        String   @id @default(uuid()) @db.Char(36)
  niche     String
  styleId   String?
  topic     String?
  sourceUrl String   @default("") @db.VarChar(2000)
  imagePath String   @default("")
  caption   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([styleId])
  @@index([niche])
}

model PinStyleOverride {
  id          String   @id @default(uuid()) @db.Char(36)
  teamId      String
  siteId      String?  @db.Char(36)
  styleId     String
  instruction String   @db.Text
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@index([teamId, styleId])
}

model PinStyleExclusion {
  id        String  @id @default(uuid()) @db.Char(36)
  teamId    String
  siteId    String  @db.Char(36)
  topic     String  @default("")
  styleId   String
  kind      String  @default("ai")
  styleName String  @default("")
  site      PinSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, topic, styleId])
}

/// Доступ к сайту (WordPress и т.п.): общая сущность портала, назначается сервисам и командам
model SiteAccess {
  id                  String    @id @default(uuid()) @db.Char(36)
  teamId              String
  kind                String    @default("wordpress")
  name                String
  baseUrl             String
  username            String
  appPasswordEnc      String    @db.Text
  mediaBaseUrl        String?
  mediaUsername       String?
  mediaAppPasswordEnc String?   @db.Text
  mediaDomain         String?
  linkDomain          String?
  /// Сервисы (slug проектов), которым доступен этот сайт; пусто — всем
  projects            Json?
  notes               String?
  lastCheckedAt       DateTime?
  lastCheckOk         Boolean?
  lastCheckNote       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  /// Дополнительные команды, которым доступен сайт (teamId — команда-владелец)
  teams               SiteAccessTeam[]
  /// Если не пусто — сайт видят только эти сотрудники (плюс админы и лидеры команды-владельца)
  viewers             SiteAccessViewer[]
  artSites            ArtSite[]

  @@index([teamId])
  @@map("PinWpConnection")
}

model SiteAccessTeam {
  accessId String     @db.Char(36)
  teamId   String
  access   SiteAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  team     Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([accessId, teamId])
  @@index([teamId])
}

model SiteAccessViewer {
  accessId String     @db.Char(36)
  userId   String
  access   SiteAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([accessId, userId])
  @@index([userId])
}

model PinRun {
  id            String       @id @default(uuid()) @db.Char(36)
  teamId        String
  siteId        String?      @db.Char(36)
  createdById   String?
  name          String       @default("")
  autopilot     Boolean      @default(true)
  stepByStep    Boolean      @default(false)
  status        PinRunStatus @default(DRAFT)
  stage         String       @default("pages")
  settings      Json
  stopRequested Boolean      @default(false)
  blockedReason String?      @db.Text
  moderatedAt   DateTime?
  costUsd       Float        @default(0)
  budgetUsd     Float?
  imagesPurgedAt DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  site          PinSite?     @relation(fields: [siteId], references: [id], onDelete: SetNull)
  pages         PinRunPage[]
  items         PinRunItem[]
  jobs          PinJob[]

  @@index([teamId, status])
  @@index([siteId, createdAt])
}

model PinRunPage {
  id                String    @id @default(uuid()) @db.Char(36)
  runId             String    @db.Char(36)
  url               String    @db.VarChar(1000)
  finalUrl          String?   @db.VarChar(1000)
  pageTitle         String    @default("") @db.Text
  h1                String    @default("") @db.Text
  keyword           String    @default("")
  boards            Json
  topic             String    @default("")
  niche             String    @default("")
  season            String    @default("")
  seasonWord        String    @default("")
  imageCount        Int       @default(0)
  sectionImageCount Int       @default(0)
  pinQuota          Int?
  canvasQuota       Int?
  pinSetId          String?   @db.Char(36)
  canvasPinSetId    String?   @db.Char(36)
  canvasHooks       Json?
  featuredImage     String?   @db.VarChar(1000)
  status            String    @default("pending")
  error             String?   @db.Text
  metaAttempts      Int       @default(0)
  photosAt          DateTime?
  plannedAt         DateTime?
  sortOrder         Int       @default(0)
  run               PinRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  items             PinRunItem[]

  @@index([runId, sortOrder])
}

model PinRunItem {
  id              String        @id @default(uuid()) @db.Char(36)
  runId           String        @db.Char(36)
  pageId          String        @db.Char(36)
  siteId          String?       @db.Char(36)
  kind            String        @default("pin")
  engine          PinEngine
  styleId         String?
  pinType         String        @default("")
  styleParams     Json?
  prompt          String        @default("") @db.Text
  pinFormat       String        @default("2:3")
  sourceImageUrl  String        @default("") @db.VarChar(1000)
  sourceImagePath String        @default("")
  imagePath       String        @default("")
  thumbPath       String        @default("")
  imageW          Int?
  imageH          Int?
  wpMediaUrl      String        @default("") @db.VarChar(1000)
  wpMediaId       String?
  title           String        @default("") @db.VarChar(255)
  description     String        @default("") @db.Text
  altText         String        @default("") @db.VarChar(600)
  targetLink      String        @default("") @db.VarChar(1000)
  boardName       String        @default("")
  scheduledAt     DateTime?
  scheduleFixed   Boolean       @default(false)
  status          PinItemStatus @default(PENDING)
  moderation      PinModeration @default(NONE)
  rejectReason    String?
  error           String?       @db.Text
  errorStage      String?
  errorKind       String?
  attempts        Int           @default(0)
  nextRetryAt     DateTime?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  run             PinRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  page            PinRunPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([runId, pageId])
  @@index([runId, engine])
  @@index([runId, moderation])
  @@index([siteId, scheduledAt])
  @@index([runId, sourceImageUrl(length: 191)])
}

model PinJob {
  id         String       @id @default(uuid()) @db.Char(36)
  runId      String       @db.Char(36)
  teamId     String
  stage      String
  status     PinJobStatus @default(PENDING)
  priority   Int          @default(0)
  options    Json?
  done       Int          @default(0)
  total      Int          @default(0)
  label      String       @default("")
  attempts   Int          @default(0)
  nextRunAt  DateTime?
  leaseUntil DateTime?
  workerId   String?
  error      String?      @db.Text
  createdAt  DateTime     @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  run        PinRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
  @@index([runId, status])
  @@index([teamId, status])
}

model PinExportLog {
  id         String   @id @default(cuid())
  teamId     String
  siteId     String   @db.Char(36)
  day        String
  fileName   String
  rows       Int      @default(0)
  userId     String?
  createdAt  DateTime @default(now())

  @@index([teamId, day])
}

model PinUrlHistory {
  id        String   @id @default(cuid())
  siteId    String   @db.Char(36)
  url       String   @db.VarChar(1000)
  runId     String?  @db.Char(36)
  createdAt DateTime @default(now())

  @@index([siteId, url(length: 191)])
}

// ───────────────────────────── Подбор доменов (Gambling) ─────────────────────────────
// Бренды × приставки (3 уровня приоритета) × зоны → проверка свободности (RDAP + DNS)
// в воркере; выбор вручную или ИИ; выгрузка CSV/XLSX. Данные видны команде автора.

enum DomainRunStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  STOPPED
}

model DomainRun {
  id              String          @id @default(uuid()) @db.Char(36)
  teamId          String?
  createdById     String
  name            String          @default("")
  status          DomainRunStatus @default(QUEUED)
  /// Все настройки подбора (бренды, зоны, уровни приставок, страна, анализ выдачи)
  settings        Json
  /// Ход проверки: текущий бренд, сколько брендов готово, сколько доменов проверено
  progress        Json?
  totalGenerated  Int             @default(0)
  totalChecked    Int             @default(0)
  totalAvailable  Int             @default(0)
  /// Бренды, для которых не набралось нужного числа свободных доменов
  incompleteBrands Json?
  stopRequested   Boolean         @default(false)
  error           String?         @db.Text
  workerId        String?
  leaseUntil      DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  domains         DomainCandidate[]

  @@index([teamId, createdAt])
  @@index([createdById, createdAt])
  @@index([status])
}

model DomainCandidate {
  id        String    @id @default(uuid()) @db.Char(36)
  runId     String    @db.Char(36)
  brand     String
  domain    String
  tld       String
  suffix    String?
  /// Уровень приставки: 1–3; 0 — без приставки
  tier      Int       @default(0)
  pattern   String    @default("brand")
  /// available | taken | unknown
  status    String    @default("unknown")
  /// rdap | dns | none
  source    String    @default("none")
  checkedAt DateTime?
  selected  Boolean   @default(false)
  aiScore   Int?
  aiReason  String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  run       DomainRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, domain])
  @@index([runId, brand, sortOrder])
  @@index([runId, status])
}

// ───────────────────────────── Pinterest Articles ─────────────────────────────
// Сервис статей-подборок под Pinterest (перенос Zewex Pinterest Articles).
// Статья — строка очереди: воркер захватывает её по lease и ведёт по этапам
// (src/lib/articles/stages.ts) до состояния ожидания или конца. Все модели с префиксом Art.

enum ArtFormat {
  REAL_PHOTO
  GENERATED_PHOTO
}

enum ArtStatus {
  PENDING
  RUNNING
  PHOTO_REVIEW
  INSUFFICIENT_PHOTOS
  WAITING_FOR_PHOTOS
  REVIEW_PENDING
  NEEDS_REWORK
  PUBLISH_QUEUED
  PUBLISHING
  COMPLETED
  PUBLISH_ERROR
  FAILED
  PAUSED
  STOPPED
}

/// Ниша или подниша (parentCode): outfits, hair, nails/manicure/pedicure, interior/decor/outdoor, blog
model ArtNiche {
  code       String   @id
  name       String
  emoji      String   @default("📄")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  parentCode String?
  profile    ArtNicheProfile?
}

/// Профиль ниши: словари поиска, обязательные визуальные признаки, оси разнообразия, подсказки для текста (JSON)
model ArtNicheProfile {
  nicheCode String   @id
  label     String
  /// {attributes, required_visuals, exclusive_terms, diversity_axes, search_templates, constraint_specs, concept_fields, fact_block}
  profile   Json
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  niche     ArtNiche @relation(fields: [nicheCode], references: [code], onDelete: Cascade)
}

/// Набор промтов на связку ниша + подниша + формат (старые UUID сохранены)
model ArtPromptSet {
  id           String      @id @db.Char(36)
  name         String
  description  String?     @db.Text
  nicheCode    String
  subnicheCode String?
  format       ArtFormat
  isActive     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  prompts      ArtPrompt[]
  recipes      ArtRecipe[]

  @@index([nicheCode, format, isActive])
}

/// Промт шага (stageKey: rp_photo_search, rp_photo_rate, rp_photo_plan, rp_section_plan, stage_2, stage_5_scene_planner,
/// stage_6_image_seo, stage_7_writer_system, stage_7_writer_user, stage_7_intro_outro). В одном наборе может быть несколько вариантов шага.
model ArtPrompt {
  id        String             @id @db.Char(36)
  setId     String             @db.Char(36)
  stageKey  String
  name      String
  system    String?            @db.LongText
  text      String             @db.LongText
  /// Справочно (модель задаётся в рецепте)
  model     String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  set       ArtPromptSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  versions  ArtPromptVersion[]

  @@index([setId, stageKey, createdAt])
}

/// История правок промта (пишется при каждом сохранении в UI)
model ArtPromptVersion {
  id            String    @id @default(uuid()) @db.Char(36)
  promptId      String    @db.Char(36)
  version       Int
  system        String?   @db.LongText
  text          String    @db.LongText
  changeSummary String?
  createdById   String?
  createdAt     DateTime  @default(now())
  prompt        ArtPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
}

/// Рецепт статьи (= сценарий оригинала): ниша, формат, набор промтов, модели и варианты по шагам, настройки поиска/текста/картинок/публикации
model ArtRecipe {
  id             String        @id @db.Char(36)
  number         Int?
  name           String
  description    String?       @db.Text
  nicheCode      String
  subnicheCode   String?
  format         ArtFormat
  promptSetId    String?       @db.Char(36)
  isActive       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  /// {stage_key: prompt_id}
  stagePromptIds Json
  /// {stage_key: "provider:model"}
  stageModels    Json
  /// {batchSize, personality, wordCount, schemaEnabled}
  text           Json
  /// {provider, model, quality, size, mode, groupId, promptId, promptWriterModel}
  images         Json
  /// PhotoSearchConfig: source, country, language, freshness, license, orientation[], minWidth, minHeight, minScore, candidatesTotal, ratingBatchSize, includeDomains, excludeDomains, imageType, uniqueMode, writerMode, captionMode, captionTemplate, querySuffix
  photoSearch    Json
  /// {mode: auto | moderate_first | publish_then_edit, seoYearUrlPercent}
  publish        Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  promptSet      ArtPromptSet? @relation(fields: [promptSetId], references: [id], onDelete: SetNull)
  sites          ArtSite[]
  runs           ArtRun[]
  articles       Article[]

  @@index([nicheCode, format, isActive])
}

/// Сайт в сервисе статей: привязка к доступу WordPress (SiteAccess), ниша, рецепт по умолчанию, автозапуск и лимиты (settings)
model ArtSite {
  id              String      @id @default(uuid()) @db.Char(36)
  teamId          String
  accessId        String?     @db.Char(36)
  name            String
  slug            String
  isActive        Boolean     @default(true)
  nicheCode       String?
  defaultRecipeId String?     @db.Char(36)
  /// ArtSiteSettings (src/lib/articles/types.ts): фото по умолчанию, модерация фото до текста, публикация, категории WP и правила,
  /// автозапуск (photoEnabled/photoLimit/writingEnabled/writingLimit/publishLimit/autoRestart), ИИ-модерация, поиск по умолчанию
  settings        Json
  /// Кэш категорий WordPress [{id, name, slug, parent}]
  wpCategories    Json?
  sortOrder       Int         @default(0)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  team            Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  access          SiteAccess? @relation(fields: [accessId], references: [id], onDelete: SetNull)
  defaultRecipe   ArtRecipe?  @relation(fields: [defaultRecipeId], references: [id], onDelete: SetNull)
  runs            ArtRun[]
  articles        Article[]

  @@unique([teamId, slug])
  @@index([teamId])
  @@index([accessId])
}

/// Запуск (партия ключей на один сайт с одним рецептом и параметрами)
model ArtRun {
  id          String     @id @default(uuid()) @db.Char(36)
  teamId      String
  siteId      String     @db.Char(36)
  recipeId    String?    @db.Char(36)
  createdById String?
  name        String     @default("")
  /// ArtRunSettings: photoCount {mode: exact|range, min, max}, photoReview, publishMode, search overrides, yearInUrl, testLabel
  settings    Json
  createdAt   DateTime   @default(now())
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  site        ArtSite    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recipe      ArtRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  articles    Article[]

  @@index([siteId, createdAt])
  @@index([teamId, createdAt])
}

/// Статья: ключ, состояние конвейера, план, тексты, мета, публикация. Одновременно строка очереди воркера.
model Article {
  id                 String      @id @default(uuid()) @db.Char(36)
  teamId             String
  siteId             String      @db.Char(36)
  runId              String?     @db.Char(36)
  recipeId           String?     @db.Char(36)
  createdById        String?
  keyword            String
  seoKeyword         String      @default("")
  focusKeyword       String      @default("")
  keywordRu          String      @default("")
  format             ArtFormat   @default(REAL_PHOTO)
  /// Сколько фото/секций нужно (из запуска: точное или уже выбранное из диапазона)
  photoCount         Int         @default(20)
  /// Модерация фото человеком/ИИ до написания текста (режим 2 оригинала)
  photoReview        Boolean     @default(true)
  /// auto | moderate_first | publish_then_edit
  publishMode        String      @default("moderate_first")
  /// Снимок рецепта и настроек запуска на момент старта (ArticleRecipeSnapshot) — его исполняет воркер
  recipe             Json
  status             ArtStatus   @default(PENDING)
  /// Текущий этап реестра (search, filter, …, publish, done)
  stage              String      @default("search")
  /// Данные этапов: кольца добора, план, контракт темы, тренд-бриф и т.п. (ArticleCursor)
  cursor             Json?
  /// Атрибуты ключа и контракт темы (parse-keyword + topicContract)
  facts              Json?
  /// План статьи: h1, title, metaDescription, slug, порядок фото, план вступления (ArticlePlan)
  plan               Json?
  introHtml          String?     @db.MediumText
  outroHtml          String?     @db.MediumText
  html               String?     @db.LongText
  h1                 String      @default("")
  metaTitle          String      @default("")
  metaDescription    String      @default("") @db.Text
  slug               String      @default("")
  wpPostId           Int?
  wpUrl              String?     @db.VarChar(1000)
  wpCategoryId       Int?
  wpStatus           String?
  publishAttempts    Int         @default(0)
  error              String?     @db.Text
  errorStage         String?
  note               String?     @db.Text
  /// Причина «Мало фото» и кто поставил
  insufficientReason String?     @db.Text
  insufficientById   String?
  insufficientByAi   Boolean     @default(false)
  attempts           Int         @default(0)
  priority           Int         @default(0)
  nextRunAt          DateTime?
  leaseUntil         DateTime?
  workerId           String?
  stopRequested      Boolean     @default(false)
  /// Закрепление за модератором (TTL 15 мин)
  claimedById        String?
  claimedAt          DateTime?
  moderatedById      String?
  moderatedAt        DateTime?
  reviewedById       String?
  reviewedAt         DateTime?
  costUsd            Float       @default(0)
  startedAt          DateTime?
  finishedAt         DateTime?
  publishedAt        DateTime?
  purgedAt           DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  team               Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  site               ArtSite     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  run                ArtRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  recipeRef          ArtRecipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  candidates         ArtPhotoCandidate[]
  photos             ArtPhoto[]
  sections           ArtSection[]
  stageLogs          ArtStageLog[]
  events             ArtModerationEvent[]
  errors             ArtError[]

  @@index([siteId, status])
  @@index([teamId, status])
  @@index([status, priority, createdAt])
  @@index([runId])
  @@index([siteId, keyword])
  @@index([claimedById])
}

/// Кандидат фото (все найденные, включая отбракованные с причиной)
model ArtPhotoCandidate {
  id            String   @id @default(uuid()) @db.Char(36)
  articleId     String   @db.Char(36)
  /// URL файла картинки (source_url DataForSEO / original SerpApi)
  url           String   @db.VarChar(2000)
  /// Страница, где найдено фото, и её домен
  pageUrl       String   @default("") @db.VarChar(2000)
  domain        String   @default("")
  thumbUrl      String   @default("") @db.VarChar(2000)
  title         String   @default("") @db.Text
  searchQuery   String   @default("")
  /// Позиция в выдаче и номер вариации запроса
  position      Int      @default(0)
  queryIndex    Int      @default(0)
  width         Int?
  height        Int?
  bytes         Int?
  sha256        String?
  phash         String?
  /// Локальный путь к скачанному оригиналу и миниатюре (storage/articles/<id>/cand/…)
  path          String   @default("")
  thumbPath     String   @default("")
  /// found | downloaded | rejected | rated | keep | selected | reserve
  status        String   @default("found")
  rejectStage   String?
  rejectReason  String?  @db.Text
  techScore     Int?
  techDetails   Json?
  beautyRank    Int?
  aiScore       Float?
  /// {virality, trend, composition, framing, lighting, …} и прочие поля vision-оценки
  aiBreakdown   Json?
  aiFacts       Json?
  aiDescription String?  @db.Text
  relevance     Float?
  audience      Json?
  rankScore     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, status])
  @@index([articleId, rankScore])
  @@index([sha256])
}

/// Фото статьи (отобранные, по позициям; одна секция = одно фото)
model ArtPhoto {
  id            String   @id @default(uuid()) @db.Char(36)
  articleId     String   @db.Char(36)
  candidateId   String?  @db.Char(36)
  position      Int
  path          String   @default("")
  thumbPath     String   @default("")
  publicUrl     String   @default("") @db.VarChar(1000)
  sourceUrl     String   @default("") @db.VarChar(2000)
  sourcePageUrl String   @default("") @db.VarChar(2000)
  sourceDomain  String   @default("")
  width         Int?
  height        Int?
  sha256        String?
  phash         String?
  altText       String   @default("") @db.Text
  caption       String   @default("") @db.Text
  fileName      String   @default("")
  facts         Json?
  description   String?  @db.Text
  aiScore       Float?
  wpMediaId     Int?
  wpUrl         String?  @db.VarChar(1000)
  /// Исключено модератором (остаётся для истории и undo)
  excluded      Boolean  @default(false)
  excludedById  String?
  excludedByAi  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, position])
  @@index([sha256])
}

/// Секция статьи (0 — вступление, 9990 — заключение, 1..n — по фото)
model ArtSection {
  id        String   @id @default(uuid()) @db.Char(36)
  articleId String   @db.Char(36)
  position  Int
  photoId   String?  @db.Char(36)
  heading   String   @default("") @db.Text
  html      String?  @db.MediumText
  /// Рецепт секции из плана (угол, объём, список, уход, честный минус)
  brief     Json?
  wordCount Int      @default(0)
  /// planned | written | failed
  status    String   @default("planned")
  error     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
}

/// Отпечатки использованных фото: уникальность между сайтами и статьями (не удаляются при очистке)
model ArtPhotoFingerprint {
  id        String   @id @default(uuid()) @db.Char(36)
  teamId    String
  siteId    String   @db.Char(36)
  articleId String?  @db.Char(36)
  sha256    String?
  phash     String?
  sourceUrl String   @default("") @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([sha256])
  @@index([phash])
  @@index([teamId, createdAt])
}

/// Действия модерации (человек или ИИ) — для статистики сотрудников и undo
model ArtModerationEvent {
  id        String   @id @default(uuid()) @db.Char(36)
  articleId String   @db.Char(36)
  userId    String?
  byAi      Boolean  @default(false)
  /// approve | exclude | restore | add | reorder | topup | insufficient | skip | review_approve | review_rework | publish
  action    String
  payload   Json?
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([userId, createdAt])
}

/// Журнал этапов статьи: таймлайн карточки статьи
model ArtStageLog {
  id         String    @id @default(uuid()) @db.Char(36)
  articleId  String    @db.Char(36)
  stage      String
  /// running | done | error | skipped
  status     String    @default("running")
  summary    String?   @db.Text
  error      String?   @db.Text
  details    Json?
  costUsd    Float     @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, startedAt])
}

/// Ошибки конвейера: группировка по сигнатуре, «устранено»
model ArtError {
  id         String    @id @default(uuid()) @db.Char(36)
  teamId     String
  siteId     String?   @db.Char(36)
  articleId  String?   @db.Char(36)
  stage      String
  message    String    @db.Text
  signature  String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([signature, createdAt])
  @@index([siteId, createdAt])
}
