# zewex.tools -> Next.js on 127.0.0.1:3100 (managed by deploy/deploy.sh)
# Included in both the :80 and :443 server blocks generated by FASTPANEL.
if ($scheme = http) {
    return 301 https://$host$request_uri;
}
# Файлы сервиса пинов (картинки, превью, примеры). Шрифты наружу не отдаём.
location ^~ /files/ {
    alias /var/www/zewex_tools_usr/data/storage/;
    expires 365d;
    add_header Cache-Control "public, immutable";
    add_header X-Robots-Tag "noindex";
    location ~ /fonts/ { return 404; }
}
location ~ ^/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    include /etc/nginx/proxy_params;
}
