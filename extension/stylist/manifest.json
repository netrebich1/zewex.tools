{
  "manifest_version": 3,
  "name": "Zewex Стилист",
  "version": "1.0.0",
  "description": "Кнопка на страницах магазинов одежды: вещь — в каталог, избранное или образ на zewex.tools; запись, есть ли вещь в магазинах.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://zewex.tools/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Zewex Стилист", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://*.zara.com/*",
        "https://*.massimodutti.com/*",
        "https://*.bershka.com/*",
        "https://*.pullandbear.com/*",
        "https://*.stradivarius.com/*",
        "https://*.oysho.com/*",
        "https://*.hm.com/*",
        "https://*.mango.com/*",
        "https://*.next.com.mt/*",
        "https://*.next.co.uk/*",
        "https://*.next.ua/*",
        "https://*.guess.com/*",
        "https://*.guess.eu/*",
        "https://*.tommy.com/*",
        "https://*.calvinklein.com/*",
        "https://hudsonstore.com/*",
        "https://*.levi.com/*",
        "https://*.newyorker.de/*",
        "https://*.terranovastyle.com/*",
        "https://*.calliope.style/*",
        "https://retail.com.mt/*",
        "https://*.kiabi.com.mt/*",
        "https://*.parfois.com/*",
        "https://*.asos.com/*",
        "https://*.desigual.com/*",
        "https://*.hugoboss.com/*",
        "https://*.lacoste.com/*",
        "https://*.tezenismalta.com/*",
        "https://*.intimissimi.com/*",
        "https://myspringfield.com.mt/*",
        "https://womensecret.com.mt/*",
        "https://*.sportsdirect.mt/*",
        "https://*.mytheresa.com/*",
        "https://*.farfetch.com/*",
        "https://*.yoox.com/*",
        "https://*.reserved.com/*",
        "https://*.sinsay.com/*",
        "https://*.mohito.com/*",
        "https://*.housebrand.com/*",
        "https://*.cropp.com/*",
        "https://answear.ua/*",
        "https://md-fashion.ua/*",
        "https://intertop.ua/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
